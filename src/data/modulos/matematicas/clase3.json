    {
      "tipo": "contenido",
      "titulo": "Tema 8 · Ángulos",
      "html": "<p class='text-lg'>Un ángulo se mide en grados (°). Dos ángulos son <strong>complementarios</strong> si suman 90° y <strong>suplementarios</strong> si suman 180°. Los ángulos interiores de todo triángulo suman 180°.</p><div style='margin:0.75rem 0;text-align:center;'><span style='display:inline-block;background-color:rgba(245,158,11,0.2);border:1px solid rgba(245,158,11,0.5);border-radius:0.375rem;padding:0.5rem 1rem;font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-weight:600;font-size:1.125rem;' class='text-slate-900 dark:text-white'>complementarios: α + β = 90°</span></div><div style='margin:0.75rem 0;text-align:center;'><span style='display:inline-block;background-color:rgba(245,158,11,0.2);border:1px solid rgba(245,158,11,0.5);border-radius:0.375rem;padding:0.5rem 1rem;font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-weight:600;font-size:1.125rem;' class='text-slate-900 dark:text-white'>suplementarios: α + β = 180°</span></div><img src='https://i.ytimg.com/vi/sH3oQD30dag/maxresdefault.jpg' alt='Tipos de ángulos' class='my-4 rounded-lg max-h-80 mx-auto' />"
    },
    {
      "tipo": "ejemplo",
      "titulo": "Ángulos · Complemento",
      "enunciado": "Encuentra el ángulo que complementa a 82°:",
      "html": "<div style='margin:0.75rem 0;text-align:center;'><span style='display:inline-block;background-color:rgba(245,158,11,0.2);border:1px solid rgba(245,158,11,0.5);border-radius:0.375rem;padding:0.5rem 1rem;font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-weight:600;font-size:1.125rem;' class='text-slate-900 dark:text-white'>α + β = 90°</span></div>"
    },
    {
      "tipo": "ejemplo",
      "titulo": "Ángulos · Suplemento",
      "enunciado": "Encuentra el ángulo suplementario de 145°:",
      "html": "<div style='margin:0.75rem 0;text-align:center;'><span style='display:inline-block;background-color:rgba(245,158,11,0.2);border:1px solid rgba(245,158,11,0.5);border-radius:0.375rem;padding:0.5rem 1rem;font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-weight:600;font-size:1.125rem;' class='text-slate-900 dark:text-white'>α + β = 180°</span></div>"
    },
